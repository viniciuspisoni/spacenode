# ── SPACENODE — exemplo de variáveis de ambiente ──────────────────────────────
#
# Arquivo criado junto com o Nodi (2026-07-17); documenta por enquanto SÓ as
# variáveis do assistente. As demais variáveis do produto (Supabase, Stripe,
# FAL, GCP…) seguem em .env.local / Vercel — ao mexer nelas, documente aqui.
# NUNCA colocar valor real neste arquivo.

# ── Nodi (assistente da plataforma) ───────────────────────────────────────────

# Liga o Nodi no /app (lido no servidor; sem NEXT_PUBLIC de propósito).
# Ativação gradual: manter desligado até validar no ambiente.
# 1 = ligado · qualquer outro valor/ausente = desligado
NODI_ENABLED=

# Provedor de IA para perguntas livres (a base de conhecimento continua
# respondendo os casos diretos mesmo sem provedor).
# off (ou vazio) = só base de conhecimento · gemini = usa lib/gemini
# (requer GEMINI_API_KEY, a mesma chave já usada por DNA/briefing)
NODI_AI_PROVIDER=

# ── Nodi V2 (copiloto agentic) — tudo desligado por padrão ────────────────────

# Orquestrador V2 (function calling). Requer NODI_ENABLED=1 também.
NODI_V2_ENABLED=

# Gate de usuários internos (INTERNAL_STAFF_EMAILS / profiles.role).
# DEFAULT FECHADO: só abre para todo mundo com 0 explícito.
NODI_INTERNAL_USERS_ONLY=

# Análise/comparação de imagem (tools de visão; custo de tokens de imagem).
NODI_MULTIMODAL_ENABLED=

# Memória estruturada por projeto (requer migration nodi_v2_project_memory).
NODI_PROJECT_MEMORY_ENABLED=

# Ações supervisionadas na interface (navegar/preencher/pré-voo de geração).
NODI_SUPERVISED_ACTIONS_ENABLED=

# Modelo do orquestrador (default gemini-2.5-flash).
# NODI_V2_MODEL=

# 1 = Gemini via Vertex AI (usa GOOGLE_VERTEX_PROJECT/_LOCATION e
# GOOGLE_VERTEX_CREDENTIALS_JSON ou GOOGLE_APPLICATION_CREDENTIALS — os mesmos
# envs do image-provider/Veo). Vazio = Gemini API direta (GEMINI_API_KEY).
# NODI_V2_USE_VERTEX=

# Tetos de uso por usuário (defaults 80/dia e 1200/mês).
# NODI_V2_DAILY_LIMIT=
# NODI_V2_MONTHLY_LIMIT=

# ── Nodi V3 (execução direta pelo chat) ──────────────────────────────────────
# Confirmar uma proposta do copiloto EXECUTA a geração (débito real, estorno
# automático em falha). Exige NODI_SUPERVISED_ACTIONS_ENABLED=1. Intents
# assinadas server-side; rate limit 10 execuções/hora por usuário.
NODI_V3_EXECUTE_ENABLED=

# Segredo próprio das intents (opcional — sem ele, deriva do service key).
# NODI_ACTION_SECRET=

# ── Dependências do Nodi já existentes no produto (referência) ────────────────
# GEMINI_API_KEY=            # já usada por Spaces/Apresentar; o Nodi só reusa
# INTERNAL_STAFF_EMAILS=     # e-mails internos (suporte vê todos os chamados + gate V2)
# GOOGLE_VERTEX_PROJECT=     # já usado por image-provider/Veo (modo Vertex)

# ── Marketing / aquisição (sistema editorial + tráfego pago) ──────────────────
# Integração Meta Marketing API (lib/meta/ads.ts + lib/marketing/ads/channels.ts).
# DECISÃO (2026-07-18): gestão de campanha no Meta fica MANUAL no Gerenciador
# de Anúncios — a conta de negócios não conseguiu acesso ao Meta for Developers
# para gerar o token de System User. O sistema não depende disso (publicação
# sempre seria pausada de qualquer forma); métricas entram por CSV no painel.
# Preencher só se um dia a automação de leitura/diagnóstico for retomada —
# passo a passo em docs/marketing/ads-system.md §5.
# META_ACCESS_TOKEN=         # token de System User (longa duração) do Business Manager
# META_AD_ACCOUNT_ID=        # conta de anúncios (com ou sem prefixo act_)
# META_PAGE_ID=              # Página do Facebook vinculada ao Instagram
# META_IG_ACCOUNT_ID=        # conta profissional do Instagram (@spacenode)
# META_APP_ID=               # app na Meta (opcional; debug de token)
# META_APP_SECRET=           # secret do app (opcional; se presente, envia appsecret_proof)

# Provedor de IA do sistema editorial/ads (lib/marketing/generation.ts).
# vazio = gemini (default; requer GEMINI_API_KEY)
# MARKETING_AI_PROVIDER=

# Cron do tráfego pago (app/api/cron/ads-alerts, app/api/cron/ads-report;
# schedule em vercel.json). A Vercel envia "Authorization: Bearer $CRON_SECRET"
# automaticamente nas chamadas de cron quando esta env existe — sem ela, as
# rotas recusam qualquer chamada (fail-closed). Gerar um valor aleatório longo
# (ex.: openssl rand -hex 32) e cadastrar igual na Vercel.
# CRON_SECRET=
