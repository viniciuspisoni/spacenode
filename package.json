{
  "name": "spacenode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:preview": "node scripts/dev-preview.mjs",
    "package:sketchup": "powershell -ExecutionPolicy Bypass -File scripts/package-sketchup-plugin.ps1",
    "package:sketchup:posix": "node scripts/package-sketchup-plugin.mjs",
    "package:sketchup:check": "node scripts/package-sketchup-plugin.mjs --check",
    "package:sketchup:verify": "node scripts/package-sketchup-plugin.mjs --verify",
    "verify:sketchup:ruby": "ruby scripts/verify-sketchup-ruby.rb",
    "verify:sketchup:flow": "node scripts/verify-sketchup-flow.mjs",
    "verify:sketchup:revisao": "node scripts/verify-sketchup-revisao.mjs",
    "verify:sketchup": "npm run verify:sketchup:ruby && npm run verify:sketchup:flow && npm run verify:sketchup:revisao && npm run package:sketchup:verify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.5",
    "@google/genai": "^2.4.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@types/three": "^0.185.1",
    "driver.js": "^1.7.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "stripe": "^22.3.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
